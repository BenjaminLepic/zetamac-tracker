{
  "manifest_version": 3,
  "name": "Zetamac Training Log",
  "version": "1.1.0",
  "description": "Record complete Zetamac games locally, with optional Google Drive sync across computers.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "identity",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Zetamac Training Log"
  },
  "content_scripts": [
    {
      "matches": [
        "https://arithmetic.zetamac.com/*"
      ],
      "js": [
        "core.js",
        "recorder.js"
      ],
      "run_at": "document_start"
    }
  ],
  "options_page": "dashboard.html",
  "host_permissions": [
    "https://www.googleapis.com/*"
  ],
  "key": "",
  "minimum_chrome_version": "120",
  "oauth2": {
    "client_id": "195507153735-fu5m591ckareeti4qhh4hl1jovkpndp7.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.appdata"
    ]
  }
}
